---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import TagFilter from '../../components/TagFilter.astro';
import { getBlogCards } from '../../lib/content';
import { BLOG_DESCRIPTION } from '../../lib/site';

const allPosts = await getBlogCards();
const allTags = [...new Set(allPosts.flatMap((p) => p.tags))].sort();
---

<BaseLayout
  title="Blog"
  description={`nasu726のブログ。${BLOG_DESCRIPTION}`}
  ogImage="/og/pages/blog.png"
>
  <div class="flex items-baseline justify-between mb-6">
    <h1 class="text-2xl font-bold text-gray-800">Blog</h1>
    <span class="text-sm text-gray-400">{allPosts.length} 記事</span>
  </div>

  <TagFilter tags={allTags} />

  <div data-tag-filter-list class="grid gap-4 sm:grid-cols-2">
    {allPosts.map((post) => (
      <div data-tags={post.tags.join(',')}>
        <PostCard {...post} />
      </div>
    ))}
  </div>

  {allPosts.length === 0 && (
    <p class="text-gray-400 text-center py-16">記事はまだありません。</p>
  )}
</BaseLayout>
