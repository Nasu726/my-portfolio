---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import Icon from '../../components/Icon.astro';
import { getWorks } from '../../lib/content';
import { GITHUB_ICON } from '../../lib/icons';

export async function getStaticPaths() {
  const works = await getWorks();
  return works.map((work) => ({ params: { slug: work.id }, props: { work } }));
}

const { work } = Astro.props;
const { links } = work.data;
const linkClass = 'inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-sm transition-colors';
---

<ArticleLayout entry={work} ogImage={`/og/works/${work.id}.png`} backHref="/Works" backLabel="作品一覧に戻る">
  {links && (
    <div slot="links" class="mt-4 flex flex-wrap gap-2">
      {links.github && (
        <a
          href={links.github}
          target="_blank"
          rel="noopener noreferrer"
          class={`${linkClass} bg-gray-100 hover:bg-gray-200 text-gray-700`}
        >
          <Icon path={GITHUB_ICON} size={14} />
          GitHub
        </a>
      )}
      {links.demo && (
        <a
          href={links.demo}
          target="_blank"
          rel="noopener noreferrer"
          class={`${linkClass} bg-purple-100 hover:bg-purple-200 text-purple-700`}
        >
          作品のページ（{new URL(links.demo).hostname}） ↗
        </a>
      )}
      {links.article && (
        <a
          href={links.article}
          target="_blank"
          rel="noopener noreferrer"
          class={`${linkClass} bg-blue-100 hover:bg-blue-200 text-blue-700`}
        >
          記事を読む ↗
        </a>
      )}
    </div>
  )}
</ArticleLayout>
