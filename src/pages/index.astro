---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import ContactButton from '../components/ContactButton.astro';
import Icon from '../components/Icon.astro';
import { getBlogCards, getWorks, toCard } from '../lib/content';
import { GITHUB_ICON, HATENA_ICON, NOTE_ICON, QIITA_ICON, X_ICON } from '../lib/icons';

// トップに出す最新の件数
const LATEST_COUNT = 4;

const posts = (await getBlogCards()).slice(0, LATEST_COUNT);
const works = (await getWorks()).slice(0, LATEST_COUNT);

const skills = [
  { category: '言語', tags: ['Python', 'C', 'MIPS'] },
  { category: 'フレームワーク', tags: ['Astro', 'React', 'TailwindCSS'] },
  { category: 'インフラ・ツール', tags: ['Linux', 'Docker', 'Cloudflare', 'Git', 'GitHub', 'VSCode'] },
];

const externalLinks = [
  { href: 'https://github.com/nasu726', label: 'GitHub', icon: GITHUB_ICON },
  { href: 'https://x.com/ueCube24_1', label: 'X (Twitter)', icon: X_ICON },
  { href: 'https://qiita.com/nasu726', label: 'Qiita', icon: QIITA_ICON },
  { href: 'https://nasu726.hatenablog.com', label: 'はてなブログ', icon: HATENA_ICON },
  { href: 'https://note.com/nasu726', label: 'note', icon: NOTE_ICON },
];
---

<BaseLayout title="Home" ogImage="/og/pages/home.png">
  <!-- ヒーロー -->
  <section class="flex flex-col items-center text-center pt-10 pb-8 gap-3">
    <img
      src="/nasucat.webp"
      alt="nasucat"
      class="w-24 h-24 rounded-full object-cover ring-4 ring-purple-200 shadow-lg"
    />
    <div>
      <h1 class="text-3xl font-bold text-gray-800">nasu</h1>
    </div>
  </section>

  <!-- 自己紹介 -->
  <section class="bg-white rounded-2xl border border-purple-100 p-6 md:p-8">
    <div class="grid md:grid-cols-[1fr_220px] gap-8">
      <!-- Bio + 略歴 -->
      <div class="space-y-6">
        <div>
          <h2 class="text-lg font-bold text-gray-700 mb-2">About</h2>
          <p class="text-gray-600 leading-relaxed text-sm">
            情報数理工学を専攻しています。<br/>
            アルゴリズムとデータ構造が好きで、競技プログラミングによく参加しています。<br/>
            ヒューリスティック探索の勉強も始めました。<br/>
            趣味で語学(ロシア語)も楽しんでいます。
          </p>
        </div>

        <div>
          <h3 class="text-sm font-semibold text-gray-500 mb-3">プロフィール</h3>
          <div class="space-y-3">
            <div>
              <p class="text-xs text-gray-400 mb-1">現在の所属</p>
              <p class="text-sm text-gray-600">電気通信大学 情報理工学域 I類 情報数理工学プログラム 3年 (2024年入学)</p>
            </div>
            <div>
              <p class="text-xs text-gray-400 mb-1">サークル・役職</p>
              <ul class="text-sm text-gray-600 space-y-0.5">
                <li>電気通信大学MMA</li>
                  <ul class="list-disc pl-5">
                    <li>合宿煙火担当（2025年～）</li>
                    <li>会計（2025年度）</li>
                  </ul>
              </ul>
            </div>
            <div>
              <p class="text-xs text-gray-400 mb-1">資格・検定</p>
              <ul class="text-sm text-gray-600 space-y-0.5">
                <li>基本情報技術者 (2025年)</li>
                <li>ロシア語能力検定試験 3級 (2025年)</li>
              </ul>
            </div>
            <div>
              <p class="text-xs text-gray-400 mb-1">その他</p>
              <ul class="text-sm text-gray-600 space-y-0.5">
                <li><a href="https://atcoder.jp/users/nasu726" target="_blank" rel="noopener noreferrer" class="underline">AtCoder (Highest 1186/1883)</a></li>
              </ul>
            </div>
          </div>
        </div>
      </div>

      <!-- スキル + 外部リンク -->
      <div class="space-y-4">
        <h3 class="text-sm font-semibold text-gray-500">Skills</h3>
        {skills.map(({ category, tags }) => (
          <div>
            <p class="text-xs text-gray-400 mb-1.5">{category}</p>
            <div class="flex flex-wrap gap-1">
              {tags.map((tag) => (
                <span class="px-2 py-0.5 rounded-full text-xs font-medium bg-purple-50 text-purple-700">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        ))}

        <div class="pt-2 border-t border-purple-50">
          <p class="text-xs text-gray-400 mb-2">外部リンク</p>
          <div class="flex flex-wrap gap-2">
            {externalLinks.map(({ href, label, icon }) => (
              <a
                href={href}
                title={label}
                target="_blank"
                rel="noopener noreferrer"
                class="w-9 h-9 flex items-center justify-center rounded-full bg-gray-50 border border-gray-100
                       text-gray-400 hover:text-purple-600 hover:bg-purple-50 hover:border-purple-200
                       transition-all"
              >
                <Icon path={icon} size={18} />
              </a>
            ))}
          </div>
        </div>

        <div class="pt-2 border-t border-purple-50">
          <p class="text-xs text-gray-400 mb-2">連絡先</p>
          <div class="flex flex-wrap gap-2">
            <ContactButton class="text-gray-600" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 最新ブログ -->
  <section class="mt-12">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-xl font-bold text-gray-700">最新のブログ</h2>
      <a href="/Blog" class="inline-block -m-3 p-3 text-sm text-purple-500 hover:text-purple-700 transition-colors">すべて見る →</a>
    </div>
    <div class="grid gap-4 sm:grid-cols-2">
      {posts.map((post) => <PostCard {...post} />)}
    </div>
    {posts.length === 0 && (
      <p class="text-gray-400 text-center py-8">記事はまだありません。</p>
    )}
  </section>

  <!-- 最新作品 -->
  <section class="mt-12">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-xl font-bold text-gray-700">最新の作品</h2>
      <a href="/Works" class="inline-block -m-3 p-3 text-sm text-purple-500 hover:text-purple-700 transition-colors">すべて見る →</a>
    </div>
    <div class="grid gap-4 sm:grid-cols-2">
      {works.map((work) => <PostCard {...toCard(work)} />)}
    </div>
    {works.length === 0 && (
      <p class="text-gray-400 text-center py-8">作品はまだありません。</p>
    )}
  </section>
</BaseLayout>
