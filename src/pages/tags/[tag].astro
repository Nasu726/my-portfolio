---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getTagIndex } from '../../lib/content';
import { tagToSlug } from '../../lib/tags';

export async function getStaticPaths() {
  const index = await getTagIndex();
  return [...index].map(([tag, data]) => ({
    // params はURLセグメントとして使われるため、リンク生成側(TagBadge等)の
    // tagToSlug(tag) と一致するスラグにしておく（+ などの記号対策）。
    params: { tag: tagToSlug(tag) },
    props: { tag, ...data },
  }));
}

const { tag, posts, works } = Astro.props;
const total = posts.length + works.length;
---

<BaseLayout
  title={`#${tag}`}
  description={`タグ「${tag}」の記事・作品一覧`}
  ogImage={`/og/tags/${tagToSlug(tag)}.png`}
>
  <h1 class="text-2xl font-bold text-gray-800 mb-1">
    <span class="text-purple-500">#</span>{tag}
  </h1>
  <p class="text-sm text-gray-400 mb-8">{total} 件</p>

  {posts.length > 0 && (
    <section class="mb-10">
      <h2 class="text-lg font-semibold text-gray-600 mb-4">Blog</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        {posts.map((post) => (
          <PostCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            tags={post.data.tags}
            href={`/Blog/${post.id}`}
          />
        ))}
      </div>
    </section>
  )}

  {works.length > 0 && (
    <section>
      <h2 class="text-lg font-semibold text-gray-600 mb-4">Works</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        {works.map((work) => (
          <PostCard
            title={work.data.title}
            description={work.data.description}
            pubDate={work.data.pubDate}
            tags={work.data.tags}
            href={`/Works/${work.id}`}
          />
        ))}
      </div>
    </section>
  )}
</BaseLayout>
