---
// ブログ記事と作品の詳細ページの共通レイアウト。
// 作品ページだけにあるリンクのボタンなどは、ヘッダーの末尾に slot="links" で差し込む。
import { render } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import TagBadge from '../components/TagBadge.astro';
import TableOfContents from '../components/TableOfContents.astro';
import type { Post, Work } from '../lib/content';
import { formatDate, readingTime } from '../lib/format';

interface Props {
  entry: Post | Work;
  ogImage: string;
  /** 記事の下に出す「一覧に戻る」リンク */
  backHref: string;
  backLabel: string;
}

const { entry, ogImage, backHref, backLabel } = Astro.props;
const { data } = entry;
const { Content, headings } = await render(entry);

const minutes = readingTime(entry.body ?? '');
// 見出しが1つだけなら目次は出さない
const MIN_TOC_HEADINGS = 2;
const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
const showToc = tocHeadings.length >= MIN_TOC_HEADINGS;
---

<BaseLayout
  title={data.title}
  description={data.description}
  ogImage={ogImage}
  ogType="article"
  useKatex
  wide
>
  <div class="lg:grid lg:grid-cols-[minmax(0,42rem)_15rem] lg:gap-10 lg:justify-center">
    <article class="max-w-2xl mx-auto lg:max-w-none lg:mx-0">
      <header class="mb-8">
        <div class="flex flex-wrap gap-1 mb-3">
          {data.tags.map((tag) => <TagBadge tag={tag} />)}
        </div>
        <h1 class="text-3xl font-bold text-gray-800 leading-tight">{data.title}</h1>
        <p class="mt-3 text-gray-500 text-sm leading-relaxed">{data.description}</p>
        <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-gray-400">
          <span>投稿: {formatDate(data.pubDate)}</span>
          {data.updatedDate && <span>更新: {formatDate(data.updatedDate)}</span>}
          <span>約 {minutes} 分で読めます</span>
        </div>
        <slot name="links" />
      </header>

      <!-- 目次（モバイル・タブレット用：本文上にインライン表示） -->
      {showToc && (
        <TableOfContents
          headings={tocHeadings}
          class="lg:hidden mb-8 px-5 py-4 bg-purple-50 rounded-xl border border-purple-100 text-sm"
        />
      )}

      <div
        class="prose prose-sm prose-gray max-w-none
          prose-headings:font-bold prose-headings:text-gray-800 prose-headings:scroll-mt-20
          prose-h2:text-xl prose-h3:text-lg
          prose-p:text-gray-700 prose-p:leading-relaxed
          prose-a:text-purple-600
          prose-strong:text-gray-800
          prose-code:text-purple-800 prose-code:bg-purple-50 prose-code:rounded
          prose-code:px-1 prose-code:py-0.5 prose-code:text-[0.85em]
          prose-code:before:content-none prose-code:after:content-none
          prose-pre:rounded-xl prose-pre:shadow-md
          prose-blockquote:border-l-purple-400 prose-blockquote:text-gray-600
          prose-blockquote:bg-purple-50/40 prose-blockquote:rounded-r
          prose-img:rounded-lg prose-img:mx-auto
          prose-table:text-sm prose-th:text-gray-700 prose-td:text-gray-600
          prose-hr:border-purple-100
        "
      >
        <Content />
      </div>

      <footer class="mt-12 pt-6 border-t border-purple-100">
        <a
          href={backHref}
          class="inline-block -m-3 p-3 text-sm text-purple-500 hover:text-purple-700 transition-colors"
        >
          ← {backLabel}
        </a>
      </footer>
    </article>

    <!-- 目次（PC全画面用：右の余白にスティッキー表示） -->
    {showToc && (
      <aside class="hidden lg:block">
        <TableOfContents
          headings={tocHeadings}
          class="sticky top-20 px-4 py-4 bg-purple-50 rounded-xl border border-purple-100 text-sm max-h-[calc(100vh-6rem)] overflow-y-auto"
        />
      </aside>
    )}
  </div>
</BaseLayout>

<script>
  // コードブロックにコピーボタンを追加
  const RESET_DELAY_MS = 2000;

  document.querySelectorAll('pre').forEach((pre) => {
    const btn = document.createElement('button');
    btn.className = 'copy-code-btn';
    btn.setAttribute('aria-label', 'コードをコピー');
    btn.textContent = 'コピー';
    btn.addEventListener('click', async () => {
      const text = pre.querySelector('code')?.innerText ?? '';
      try {
        await navigator.clipboard.writeText(text);
        btn.textContent = 'コピー済み ✓';
        btn.classList.add('copied');
        setTimeout(() => {
          btn.textContent = 'コピー';
          btn.classList.remove('copied');
        }, RESET_DELAY_MS);
      } catch {
        btn.textContent = '失敗';
        setTimeout(() => {
          btn.textContent = 'コピー';
        }, RESET_DELAY_MS);
      }
    });
    pre.classList.add('has-copy-btn');
    pre.appendChild(btn);
  });
</script>
