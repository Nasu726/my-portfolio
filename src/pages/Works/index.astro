---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import TagFilter from '../../components/TagFilter.astro';
import { getWorks, toCard } from '../../lib/content';
import { WORKS_DESCRIPTION } from '../../lib/site';

const allWorks = await getWorks();
const allTags = [...new Set(allWorks.flatMap((w) => w.data.tags))].sort();
---

<BaseLayout
  title="Works"
  description={`nasu726の作品一覧。${WORKS_DESCRIPTION}`}
  ogImage="/og/pages/works.png"
>
  <div class="flex items-baseline justify-between mb-6">
    <h1 class="text-2xl font-bold text-gray-800">Works</h1>
    <span class="text-sm text-gray-400">{allWorks.length} 件</span>
  </div>

  <TagFilter tags={allTags} />

  <div data-tag-filter-list class="grid gap-4 sm:grid-cols-2">
    {allWorks.map((work) => (
      <div data-tags={work.data.tags.join(',')}>
        <PostCard {...toCard(work)} />
      </div>
    ))}
  </div>

  {allWorks.length === 0 && (
    <p class="text-gray-400 text-center py-16">作品はまだありません。</p>
  )}
</BaseLayout>
